# Supabase project URL, e.g. https://YOUR_PROJECT_ID.supabase.co
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Public/publishable Supabase key. Safe for browser use, but still configure RLS.
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Browser build variables. These must contain public values only.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only secret. Never prefix with VITE_ and never expose to the browser.
# Required if server admin operations use the Supabase service-role client.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Server-only key for the Lovable AI Gateway; required for the AI chat.
LOVABLE_API_KEY=YOUR_LOVABLE_API_KEY

# Optional: PostgreSQL connection string used by Drizzle Kit migrations.
# Use a database password/connection string with the minimum privileges needed.
LOVABLE_DB_MIGRATION_URL=

# Optional: required only if protected cron routes are used.
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
